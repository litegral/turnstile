# Docker Compose database settings.
POSTGRES_DB=turnstile
POSTGRES_USER=turnstile
POSTGRES_PASSWORD=turnstile
API_PORT=8080
ACCOUNTING_PORT=8081
MOCK_ACCOUNTING_FAILURES=2

# Application settings. Blank values use Go defaults.
HTTP_ADDR=
LOG_LEVEL=
DB_MAX_CONNECTIONS=
DB_MIN_CONNECTIONS=
HTTP_READ_TIMEOUT=
HTTP_WRITE_TIMEOUT=
HTTP_IDLE_TIMEOUT=
BOOKING_TIMEOUT=
WEBHOOK_TIMEOUT=
SHUTDOWN_TIMEOUT=
DB_CONNECT_TIMEOUT=
DB_HEALTH_TIMEOUT=

# Accounting outbox delivery.
ACCOUNTING_URL=http://localhost:8081/transaction
ACCOUNTING_TIMEOUT=
ACCOUNTING_FAILURE_THRESHOLD=
ACCOUNTING_CIRCUIT_OPEN=
OUTBOX_CONCURRENCY=
OUTBOX_POLL_INTERVAL=
OUTBOX_LEASE_DURATION=
OUTBOX_DELIVERY_TIMEOUT=
OUTBOX_BASE_RETRY_DELAY=
OUTBOX_MAX_RETRY_DELAY=

# Host-only execution; Compose builds DATABASE_URL from settings above.
DATABASE_URL=postgres://turnstile:turnstile@localhost:5432/turnstile?sslmode=disable
